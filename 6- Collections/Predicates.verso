    {
      "id": "07b8ea25-bf84-42f9-a45c-eae21c0fe8fb",
      "type": "code",
      "language": "csharp",
      "source": "Predicate\u003Cint\u003E isGreaterThanTen = IsGreaterThanTen;\r\npublic static bool IsGreaterThanTen(int x) =\u003E x \u003E 10;\r\nisGreaterThanTen(12)",
      "outputs": [
        {
          "mimeType": "text/plain",
          "content": "True"
        }
      ]
    },
