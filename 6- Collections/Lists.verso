j-border);background:var(--obj-header-bg);font-weight:600;white-space:nowrap;}.verso-obj-tree table.verso-obj-table td.verso-obj-member{padding:3px 10px;border-bottom:1px solid var(--obj-border);color:var(--obj-muted);white-space:nowrap;vertical-align:top;font-size:12px;}.verso-obj-tree table.verso-obj-table td.verso-obj-value{padding:3px 10px;border-bottom:1px solid var(--obj-border);vertical-align:top;}.verso-obj-tree table.verso-obj-table tbody tr:hover{background:var(--obj-hover);}.verso-obj-tree .verso-obj-null{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-cycle{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-empty{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-footer{padding:4px 10px;color:var(--obj-muted);font-size:11px;border-top:1px solid var(--obj-border);}\u003C/style\u003E\u003Cdiv class=\u0022verso-obj-tree\u0022\u003E\u003Cdetails class=\u0022verso-obj-node\u0022 open\u003E\u003Csummary class=\u0022verso-obj-summary\u0022\u003E\u003Cspan class=\u0022verso-obj-type\u0022\u003EList\u0026lt;Product\u0026gt;\u003C/span\u003E\u003Cspan class=\u0022verso-obj-count\u0022\u003E (11 items)\u003C/span\u003E\u003C/summary\u003E\u003Ctable class=\u0022verso-obj-table\u0022\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EName\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EPrice\u003C/th\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EIsStoked\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EWireless Mouse\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E25.99\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EMechanical Keyboard\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E89.50\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E27-inch 4K Monitor\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E349.99\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EFalse\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EUSB-C Hub\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E45.00\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ENoise-Cancelling Headphones\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E199.95\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EWebcam 1080p\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E59.99\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EFalse\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EExternal SSD 1TB\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E109.00\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EErgonomic Office Chair\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E275.50\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ELED Desk Lamp\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E32.99\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ETrue\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003ELaptop Stand\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E49.99\u003C/td\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003EFalse\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u00