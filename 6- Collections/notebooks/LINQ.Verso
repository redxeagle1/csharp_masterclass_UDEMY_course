j-border);background:var(--obj-header-bg);font-weight:600;white-space:nowrap;}.verso-obj-tree table.verso-obj-table td.verso-obj-member{padding:3px 10px;border-bottom:1px solid var(--obj-border);color:var(--obj-muted);white-space:nowrap;vertical-align:top;font-size:12px;}.verso-obj-tree table.verso-obj-table td.verso-obj-value{padding:3px 10px;border-bottom:1px solid var(--obj-border);vertical-align:top;}.verso-obj-tree table.verso-obj-table tbody tr:hover{background:var(--obj-hover);}.verso-obj-tree .verso-obj-null{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-cycle{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-empty{color:var(--obj-muted);font-style:italic;}.verso-obj-tree .verso-obj-footer{padding:4px 10px;color:var(--obj-muted);font-size:11px;border-top:1px solid var(--obj-border);}\u003C/style\u003E\u003Cdiv class=\u0022verso-obj-tree\u0022\u003E\u003Cdetails class=\u0022verso-obj-node\u0022 open\u003E\u003Csummary class=\u0022verso-obj-summary\u0022\u003E\u003Cspan class=\u0022verso-obj-type\u0022\u003EList\u0026lt;Int32\u0026gt;\u003C/span\u003E\u003Cspan class=\u0022verso-obj-count\u0022\u003E (100 items)\u003C/span\u003E\u003C/summary\u003E\u003Ctable class=\u0022verso-obj-table\u0022\u003E\u003Cthead\u003E\u003Ctr\u003E\u003Cth class=\u0022verso-obj-th\u0022\u003EValue\u003C/th\u003E\u003C/tr\u003E\u003C/thead\u003E\u003Ctbody\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E109\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E860\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E377\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E337\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E392\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003Ctd class=\u0022verso-obj-value\u0022\u003E753\u003C/td\u003E\u003C/tr\u003E\u003Ctr\u003E\u003C