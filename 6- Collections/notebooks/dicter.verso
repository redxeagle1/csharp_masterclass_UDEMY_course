      "id": "78684451-e3eb-4ced-ad03-e06d41a5ca92",
      "type": "code",
      "language": "csharp",
      "source": "Dictionary\u003Cint, string\u003E employees = new() \r\n{\r\n    [1] = \u0022Julia\u0022,\r\n    [2] = \u0022Anna\u0022,\r\n    [3] = \u0022Thomas\u0022\r\n};\r\n\r\nemployees.Add(111,\u0022bonnie blue\u0022);\r\n\r\nemployees",
      "outputs": [
        {
          "mimeType": "text/html",
