    {
      "id": "cd96d18a-7251-44de-a951-390ce055a3fc",
      "type": "code",
      "language": "csharp",
      "source": "class Employee(string name, int age, int salary)\r\n{\r\n    public string Name { get; set; } = name;\r\n    public int Age { get; set; } = age;\r\n    public int Salary { get; set; } = salary;\r\n}\r\nDictionary\u003Cint,Employee\u003E employeesTable = new()\r\n{\r\n    [1] = new Employee(\u0022John Does\u0022, 35, 100000),\r\n    [2] = new Employee(\u0022John Doesnt\u0022, 25, 200000),\r\n    [3] = new Employee(\u0022John Wasnt\u0022, 45, 80000),\r\n    [4] = new Employee(\u0022John Will\u0022, 15, 50000)\r\n};\r\n\r\nemployeesTable",
      "outputs": [
        {
